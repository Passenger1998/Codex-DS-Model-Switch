#!/bin/zsh
set -euo pipefail

codex_home="${CODEX_SWITCHER_CODEX_HOME:-$HOME/.codex}"
config_file="$codex_home/config.toml"
catalog_file="$codex_home/deepseek.models.json"
chatgpt_state="$codex_home/chatgpt.activation.toml"
backup_dir="$codex_home/provider-switch-backups"
lock_dir="$codex_home/.provider-switch.lock"
proxy_plist="${CODEX_SWITCHER_PROXY_PLIST:-$HOME/Library/LaunchAgents/local.codex-deepseek-proxy.plist}"
proxy_label="local.codex-deepseek-proxy"
proxy_health="http://127.0.0.1:4878/health"
proxy_upstream_health="http://127.0.0.1:4878/upstream-health"
launch_domain="gui/$(id -u)"

if [[ -n "${CODEX_SWITCHER_CODEX_BIN:-}" ]]; then
  codex_bin="$CODEX_SWITCHER_CODEX_BIN"
elif [[ -x /Applications/ChatGPT.app/Contents/Resources/codex ]]; then
  codex_bin=/Applications/ChatGPT.app/Contents/Resources/codex
else
  codex_bin="$(command -v codex 2>/dev/null || true)"
fi

usage() {
  print -u2 "Usage: codex-provider {chatgpt|deepseek-high|deepseek-max|deepseek|status}"
  exit 2
}

root_value() {
  local wanted="$1"
  awk -v wanted="$wanted" '
    /^[[:space:]]*\[/ { exit }
    {
      line=$0
      if (line ~ "^[[:space:]]*" wanted "[[:space:]]*=") {
        sub(/^[^=]*=[[:space:]]*/, "", line)
        gsub(/^[\"[:space:]]+|[\"[:space:]]+$/, "", line)
        print line
        exit
      }
    }
  ' "$config_file"
}

provider_exists() {
  awk '
    /^[[:space:]]*\[model_providers\.deepseek\][[:space:]]*$/ { found=1 }
    END { exit(found ? 0 : 1) }
  ' "$config_file"
}

proxy_ready() {
  /usr/bin/curl --noproxy '*' --fail --silent --max-time 2 "$proxy_health" >/dev/null 2>&1
}

proxy_health_json() {
  /usr/bin/curl --noproxy '*' --fail --silent --show-error --max-time 3 "$proxy_health"
}

keychain_ready() {
  /usr/bin/security find-generic-password -s codex-deepseek-api-key >/dev/null 2>&1
}

plist_argument() {
  local wanted="$1"
  local count index value
  [[ -f "$proxy_plist" ]] || return 1
  count="$(/usr/bin/plutil -extract ProgramArguments raw -o - "$proxy_plist" 2>/dev/null)" || return 1
  [[ "$count" == <-> ]] || return 1
  for (( index=0; index<count; index++ )); do
    value="$(/usr/bin/plutil -extract "ProgramArguments.$index" raw -o - "$proxy_plist" 2>/dev/null)" || return 1
    if [[ "$value" == "$wanted" && $((index + 1)) -lt count ]]; then
      /usr/bin/plutil -extract "ProgramArguments.$((index + 1))" raw -o - "$proxy_plist" 2>/dev/null
      return
    fi
  done
  return 1
}

running_argument() {
  local wanted="$1"
  /bin/launchctl print "$launch_domain/$proxy_label" 2>/dev/null | awk -v wanted="$wanted" '
    /^[[:space:]]*arguments = \{/ { in_arguments=1; next }
    in_arguments && /^[[:space:]]*}/ { exit }
    in_arguments {
      line=$0
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      if (take_next) { print line; exit }
      if (line == wanted) take_next=1
    }
  '
}

set_plist_argument() {
  local plist_file="$1"
  local wanted="$2"
  local replacement="$3"
  local count index value
  count="$(/usr/bin/plutil -extract ProgramArguments raw -o - "$plist_file" 2>/dev/null)" || return 1
  [[ "$count" == <-> ]] || return 1
  for (( index=0; index<count; index++ )); do
    value="$(/usr/bin/plutil -extract "ProgramArguments.$index" raw -o - "$plist_file" 2>/dev/null)" || return 1
    if [[ "$value" == "$wanted" && $((index + 1)) -lt count ]]; then
      /usr/libexec/PlistBuddy -c "Set :ProgramArguments:$((index + 1)) $replacement" "$plist_file" >/dev/null
      return
    fi
  done
  print -u2 "LaunchAgent is missing required argument: $wanted"
  return 1
}

restart_proxy() {
  local attempt
  /bin/launchctl bootout "$launch_domain/$proxy_label" >/dev/null 2>&1 || true
  for attempt in {1..30}; do
    /bin/launchctl print "$launch_domain/$proxy_label" >/dev/null 2>&1 || break
    sleep 0.1
  done
  for attempt in {1..3}; do
    if /bin/launchctl bootstrap "$launch_domain" "$proxy_plist" >/dev/null 2>&1; then
      break
    fi
    [[ "$attempt" -eq 3 ]] && {
      print -u2 "Failed to load DeepSeek proxy LaunchAgent."
      return 1
    }
    sleep 0.2
  done
  /bin/launchctl kickstart -k "$launch_domain/$proxy_label" >/dev/null
  for attempt in {1..200}; do
    proxy_ready && return 0
    sleep 0.1
  done
  print -u2 "DeepSeek local proxy did not become healthy. Check ~/.codex/log/deepseek-proxy.err.log"
  return 1
}

verify_proxy_effort() {
  local expected="$1"
  local health running_effort running_thinking
  health="$(proxy_health_json)" || return 1
  running_effort="$(running_argument --reasoning-effort || true)"
  running_thinking="$(running_argument --thinking || true)"
  [[ "$health" == *'"thinking":"enabled"'* ]] || {
    print -u2 "DeepSeek proxy health reports Thinking is not enabled."
    return 1
  }
  [[ "$health" == *"\"reasoning_effort\":\"$expected\""* ]] || {
    print -u2 "DeepSeek proxy health does not match requested reasoning effort: $expected"
    return 1
  }
  [[ "$running_thinking" == enabled && "$running_effort" == "$expected" ]] || {
    print -u2 "Running DeepSeek proxy arguments do not match thinking=enabled, reasoning_effort=$expected"
    return 1
  }
  if [[ "$expected" == max ]]; then
    [[ "$health" == *'"accepted_codex_reasoning_efforts":["high","xhigh"]'* ]] || {
      print -u2 "DeepSeek Max proxy cannot accept both existing High tasks and new xhigh tasks."
      return 1
    }
  else
    [[ "$health" == *'"accepted_codex_reasoning_efforts":["high"]'* ]] || {
      print -u2 "DeepSeek High proxy reports unexpected accepted Codex reasoning efforts."
      return 1
    }
  fi
}

check_upstream() {
  local result elapsed
  if ! result="$(/usr/bin/curl --noproxy '*' --fail --silent --show-error --max-time 35 \
      -H 'Authorization: Bearer codex-deepseek-local' "$proxy_upstream_health" 2>&1)"; then
    print -u2 "DeepSeek upstream health check failed: $result"
    return 1
  fi
  [[ "$result" == *'"status":"ok"'* ]] || {
    print -u2 "DeepSeek upstream health check returned an unexpected response."
    return 1
  }
  elapsed="$(print -r -- "$result" | sed -n 's/.*"elapsed_ms":\([0-9][0-9]*\).*/\1/p')"
  print "upstream_health=ok"
  [[ -n "$elapsed" ]] && print "upstream_elapsed_ms=$elapsed"
}

show_status() {
  local active_provider active_model catalog codex_effort
  local plist_effort plist_thinking process_effort process_thinking
  local current_state state_label consistent effective_effort health proxy_accepts
  active_provider="$(root_value model_provider)"
  active_model="$(root_value model)"
  catalog="$(root_value model_catalog_json)"
  codex_effort="$(root_value model_reasoning_effort)"
  plist_effort="$(plist_argument --reasoning-effort || true)"
  plist_thinking="$(plist_argument --thinking || true)"
  process_effort="$(running_argument --reasoning-effort || true)"
  process_thinking="$(running_argument --thinking || true)"
  health="$(proxy_health_json 2>/dev/null || true)"
  proxy_accepts=unknown
  [[ "$health" == *'"accepted_codex_reasoning_efforts":["high"]'* ]] && proxy_accepts=high
  [[ "$health" == *'"accepted_codex_reasoning_efforts":["high","xhigh"]'* ]] && proxy_accepts=high,xhigh
  [[ -n "$active_provider" ]] || active_provider=openai
  consistent=yes
  if [[ "$active_provider" != deepseek ]]; then
    current_state=chatgpt
    state_label="ChatGPT"
    effective_effort="${codex_effort:-built-in-default}"
  elif [[ "$active_model" == deepseek-v4-pro && "$codex_effort" == high \
      && "$plist_effort" == high && "$plist_thinking" == enabled \
      && "$process_effort" == high && "$process_thinking" == enabled \
      && "$proxy_accepts" == high ]] && proxy_ready; then
    current_state=deepseek-high
    state_label="DeepSeek V4 Pro · High"
    effective_effort=high
  elif [[ "$active_model" == deepseek-v4-pro && "$codex_effort" == xhigh \
      && "$plist_effort" == max && "$plist_thinking" == enabled \
      && "$process_effort" == max && "$process_thinking" == enabled \
      && "$proxy_accepts" == high,xhigh ]] && proxy_ready; then
    current_state=deepseek-max
    state_label="DeepSeek V4 Pro · Max"
    effective_effort=max
  else
    current_state=inconsistent
    state_label="配置不一致"
    consistent=no
    effective_effort=unknown
  fi
  print "current_state=$current_state"
  print "state_label=$state_label"
  print "state_consistent=$consistent"
  print "provider=$active_provider"
  print "model=${active_model:-built-in-default}"
  print "codex_reasoning_effort=${codex_effort:-built-in-default}"
  print "effective_reasoning_effort=$effective_effort"
  print "proxy_plist_thinking=${plist_thinking:-unknown}"
  print "proxy_plist_reasoning_effort=${plist_effort:-unknown}"
  print "proxy_running_thinking=${process_thinking:-stopped}"
  print "proxy_running_reasoning_effort=${process_effort:-stopped}"
  print "proxy_accepted_codex_reasoning_efforts=$proxy_accepts"
  print "service_tier=${$(root_value service_tier):-built-in-default}"
  print "model_catalog=${catalog:-built-in}"
  provider_exists && print "deepseek_provider=present" || print "deepseek_provider=MISSING"
  keychain_ready && print "deepseek_keychain=present" || print "deepseek_keychain=missing"
  proxy_ready && print "deepseek_proxy=running" || print "deepseek_proxy=stopped"
}

[[ $# -eq 1 ]] || usage
mode="$1"
case "$mode" in
  status)
    [[ -f "$config_file" ]] || { print -u2 "Missing $config_file"; exit 1; }
    show_status
    exit 0
    ;;
  deepseek)
    mode=deepseek-high
    ;;
  chatgpt|deepseek-high|deepseek-max) ;;
  *) usage ;;
esac

[[ -f "$config_file" ]] || { print -u2 "Missing $config_file"; exit 1; }
[[ -x "$codex_bin" ]] || { print -u2 "Missing Codex CLI"; exit 1; }
provider_exists || { print -u2 "Refusing to switch: [model_providers.deepseek] is missing"; exit 1; }

target_codex_effort=""
target_proxy_effort=""
if [[ "$mode" == deepseek-* ]]; then
  if [[ "$mode" == deepseek-max ]]; then
    # Codex currently exposes up to xhigh. The compatibility proxy translates
    # this explicit transport value to DeepSeek V4 Pro's upstream max effort.
    target_codex_effort=xhigh
    target_proxy_effort=max
  else
    target_codex_effort=high
    target_proxy_effort=high
  fi
  [[ -f "$catalog_file" ]] || { print -u2 "Missing $catalog_file"; exit 1; }
  [[ -f "$proxy_plist" ]] || { print -u2 "Missing DeepSeek proxy LaunchAgent: $proxy_plist"; exit 1; }
  keychain_ready || { print -u2 "Missing Keychain item: codex-deepseek-api-key"; exit 1; }
fi

if ! mkdir "$lock_dir" 2>/dev/null; then
  print -u2 "Another provider switch is already running."
  exit 1
fi

tmp_prefix=""
tmp_candidate=""
tmp_plist=""
verify_home=""
config_applied=0
plist_applied=0
switch_committed=0
config_backup=""
plist_backup=""

cleanup() {
  set +e
  if [[ "$switch_committed" -eq 0 ]]; then
    if [[ "$config_applied" -eq 1 && -n "$config_backup" && -f "$config_backup" ]]; then
      cp -p "$config_backup" "$config_file"
    fi
    if [[ "$plist_applied" -eq 1 && -n "$plist_backup" && -f "$plist_backup" ]]; then
      cp -p "$plist_backup" "$proxy_plist"
      restart_proxy >/dev/null 2>&1 || true
    fi
  fi
  [[ -n "$tmp_prefix" && -e "$tmp_prefix" ]] && rm -f "$tmp_prefix"
  [[ -n "$tmp_candidate" && -e "$tmp_candidate" ]] && rm -f "$tmp_candidate"
  [[ -n "$tmp_plist" && -e "$tmp_plist" ]] && rm -f "$tmp_plist"
  [[ -n "$verify_home" && -d "$verify_home" ]] && rm -rf "$verify_home"
  rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

mkdir -p "$backup_dir"
chmod 700 "$backup_dir"
stamp="$(date '+%Y%m%d-%H%M%S')-$$"
config_backup="$backup_dir/config.toml.$stamp.before-$mode.bak"
cp -p "$config_file" "$config_backup"
if [[ -f "$proxy_plist" ]]; then
  plist_backup="$backup_dir/local.codex-deepseek-proxy.plist.$stamp.before-$mode.bak"
  cp -p "$proxy_plist" "$plist_backup"
fi

current_provider="$(root_value model_provider)"
if [[ "$mode" == deepseek-* && "$current_provider" != deepseek ]]; then
  state_tmp="$(mktemp "$codex_home/.chatgpt.activation.toml.XXXXXX")"
  awk '
    /^[[:space:]]*\[/ { exit }
    /^[[:space:]]*model[[:space:]]*=/ { print }
    /^[[:space:]]*model_reasoning_effort[[:space:]]*=/ { print }
    /^[[:space:]]*service_tier[[:space:]]*=/ { print }
  ' "$config_file" > "$state_tmp"
  chmod 600 "$state_tmp"
  mv -f "$state_tmp" "$chatgpt_state"
fi

tmp_prefix="$(mktemp "$codex_home/.config.prefix.XXXXXX")"
tmp_candidate="$(mktemp "$codex_home/.config.candidate.XXXXXX")"

if [[ "$mode" == deepseek-* ]]; then
  print 'model = "deepseek-v4-pro"' > "$tmp_prefix"
  print 'model_provider = "deepseek"' >> "$tmp_prefix"
  print "model_reasoning_effort = \"$target_codex_effort\"" >> "$tmp_prefix"
  print "model_catalog_json = \"$catalog_file\"" >> "$tmp_prefix"
else
  [[ -f "$chatgpt_state" ]] || { print -u2 "Missing saved ChatGPT activation state"; exit 1; }
  cp "$chatgpt_state" "$tmp_prefix"
fi

awk -v prefix_file="$tmp_prefix" '
  function emit_prefix( line, rc) {
    while ((rc = getline line < prefix_file) > 0) print line
    close(prefix_file)
    emitted=1
  }
  BEGIN { in_table=0; emitted=0 }
  !in_table && /^[[:space:]]*(model|model_provider|model_reasoning_effort|model_catalog_json|service_tier|forced_login_method|preferred_auth_method)[[:space:]]*=/ {
    if (!emitted) emit_prefix()
    next
  }
  !in_table && /^[[:space:]]*\[/ {
    if (!emitted) emit_prefix()
    in_table=1
  }
  { print }
  END { if (!emitted) emit_prefix() }
' "$config_file" > "$tmp_candidate"
chmod 600 "$tmp_candidate"

verify_home="$(mktemp -d "${TMPDIR:-/tmp}/codex-provider-verify.XXXXXX")"
cp "$tmp_candidate" "$verify_home/config.toml"
CODEX_HOME="$verify_home" "$codex_bin" debug models >/dev/null

if [[ "$mode" == deepseek-* ]]; then
  tmp_plist="$(mktemp "${proxy_plist}.candidate.XXXXXX")"
  cp -p "$proxy_plist" "$tmp_plist"
  set_plist_argument "$tmp_plist" --thinking enabled
  set_plist_argument "$tmp_plist" --reasoning-effort "$target_proxy_effort"
  /usr/bin/plutil -lint "$tmp_plist" >/dev/null
  mv -f "$tmp_plist" "$proxy_plist"
  tmp_plist=""
  chmod 600 "$proxy_plist"
  plist_applied=1
  restart_proxy
  verify_proxy_effort "$target_proxy_effort"
  health_summary="$(check_upstream)"
fi

mv -f "$tmp_candidate" "$config_file"
tmp_candidate=""
chmod 600 "$config_file"
config_applied=1

provider_exists || { print -u2 "Post-switch invariant failed: DeepSeek provider disappeared."; exit 1; }

if [[ "$mode" == deepseek-* ]]; then
  models_check="$("$codex_bin" debug models 2>/dev/null)"
  [[ "$models_check" == *'"slug":"deepseek-v4-pro"'* ]] || {
    print -u2 "Codex model catalog does not contain deepseek-v4-pro."
    exit 1
  }
  actual_effort="$(root_value model_reasoning_effort)"
  [[ "$(root_value model_provider)" == deepseek && "$actual_effort" == "$target_codex_effort" ]] || {
    print -u2 "Codex configuration does not match requested DeepSeek effort."
    exit 1
  }
  actual_state="$(show_status | awk -F= '$1 == "current_state" { print $2 }')"
  [[ "$actual_state" == "$mode" ]] || {
    print -u2 "Post-switch state is inconsistent: expected $mode, got ${actual_state:-unknown}."
    exit 1
  }
  effort_label=High
  [[ "$target_proxy_effort" == max ]] && effort_label=Max
  print "DeepSeek V4 Pro · $effort_label is active for new sessions."
  print "codex_transport_reasoning_effort=$target_codex_effort"
  print "deepseek_upstream_reasoning_effort=$target_proxy_effort"
  print -r -- "$health_summary"
else
  [[ "$(root_value model_provider)" != deepseek ]] || {
    print -u2 "ChatGPT/OpenAI activation still points to DeepSeek."
    exit 1
  }
  [[ -z "$(root_value model_catalog_json)" ]] || {
    print -u2 "ChatGPT/OpenAI activation unexpectedly retained the DeepSeek model catalog."
    exit 1
  }
  print "ChatGPT/OpenAI is active for new sessions."
fi

switch_committed=1
print "Backup: $config_backup"
[[ -n "$plist_backup" ]] && print "LaunchAgent backup: $plist_backup"
print "Provider configuration switch completed."
show_status
