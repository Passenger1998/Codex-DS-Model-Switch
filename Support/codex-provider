#!/bin/zsh
set -euo pipefail

codex_home="${CODEX_SWITCHER_CODEX_HOME:-$HOME/.codex}"
script_dir="${0:A:h}"
config_file="$codex_home/config.toml"
catalog_file="$codex_home/deepseek.models.json"
profile_file="$codex_home/deepseek-credential-profiles.json"
profiles_tool="${CODEX_SWITCHER_CREDENTIAL_PROFILES_TOOL:-$script_dir/credential_profiles.py}"
chatgpt_state="$codex_home/chatgpt.activation.toml"
backup_dir="$codex_home/provider-switch-backups"
lock_dir="$codex_home/.provider-switch.lock"
proxy_plist="${CODEX_SWITCHER_PROXY_PLIST:-$HOME/Library/LaunchAgents/local.codex-deepseek-proxy.plist}"
proxy_label="local.codex-deepseek-proxy"
proxy_health="http://127.0.0.1:4878/health"
proxy_upstream_health="http://127.0.0.1:4878/upstream-health"
launch_domain="gui/$(id -u)"
curl_bin="${CODEX_SWITCHER_CURL_BIN:-/usr/bin/curl}"

if [[ -n "${CODEX_SWITCHER_CODEX_BIN:-}" ]]; then
  codex_bin="$CODEX_SWITCHER_CODEX_BIN"
elif [[ -x /Applications/ChatGPT.app/Contents/Resources/codex ]]; then
  codex_bin=/Applications/ChatGPT.app/Contents/Resources/codex
else
  codex_bin="$(command -v codex 2>/dev/null || true)"
fi

usage() {
  print -u2 "Usage: codex-provider {chatgpt|deepseek [--credential <profile-id-or-name>]|status}"
  exit 2
}

fsync_directory() {
  /usr/bin/python3 -c 'import os, sys; fd=os.open(sys.argv[1], os.O_RDONLY); os.fsync(fd); os.close(fd)' "$1"
}

atomic_restore_file() {
  local source="$1" destination="$2" restore_tmp
  restore_tmp="$(mktemp "${destination:h}/.${destination:t}.rollback.XXXXXX")"
  cp -p "$source" "$restore_tmp"
  mv -f "$restore_tmp" "$destination"
  fsync_directory "${destination:h}"
}

root_value() {
  local wanted="$1"
  awk -v wanted="$wanted" '
    /^[[:space:]]*\[/ { exit }
    {
      line=$0
      if (line ~ "^[[:space:]]*" wanted "[[:space:]]*=") {
        sub(/^[^=]*=[[:space:]]*/, "", line)
        gsub(/^[\"[:space:]]+|[\"[:space:]]+$/, "", line)
        print line
        exit
      }
    }
  ' "$config_file"
}

provider_exists() {
  awk '
    /^[[:space:]]*\[model_providers\.deepseek\][[:space:]]*$/ { found=1 }
    END { exit(found ? 0 : 1) }
  ' "$config_file"
}

proxy_ready() {
  "$curl_bin" --noproxy '*' --fail --silent --max-time 2 "$proxy_health" >/dev/null 2>&1
}

ensure_proxy() {
  local attempt
  proxy_ready && return 0
  # The proxy is now effort-dynamic; only start it when it is not already healthy.
  /bin/launchctl bootstrap "$launch_domain" "$proxy_plist" >/dev/null 2>&1 || true
  /bin/launchctl kickstart -k "$launch_domain/$proxy_label" >/dev/null 2>&1 || true
  for attempt in {1..200}; do
    proxy_ready && return 0
    sleep 0.1
  done
  print -u2 "DeepSeek local proxy did not become healthy. Check ~/.codex/log/deepseek-proxy.err.log"
  return 1
}

check_upstream() {
  local result elapsed
  if ! result="$("$curl_bin" --noproxy '*' --fail --silent --show-error --max-time 35 \
      -H 'Authorization: Bearer codex-deepseek-local' "$proxy_upstream_health" 2>&1)"; then
    print -u2 "DeepSeek upstream health check failed: $result"
    return 1
  fi
  [[ "$result" == *'"status":"ok"'* ]] || {
    print -u2 "DeepSeek upstream health check returned an unexpected response."
    return 1
  }
  elapsed="$(print -r -- "$result" | sed -n 's/.*"elapsed_ms":\([0-9][0-9]*\).*/\1/p')"
  print "upstream_health=ok"
  [[ -n "$elapsed" ]] && print "upstream_elapsed_ms=$elapsed"
}

show_status() {
  local active_provider active_model catalog codex_effort
  local current_state state_label consistent inconsistency_reason
  local credential_status credential_valid credential_reason
  active_provider="$(root_value model_provider)"
  active_model="$(root_value model)"
  catalog="$(root_value model_catalog_json)"
  codex_effort="$(root_value model_reasoning_effort)"
  [[ -n "$active_provider" ]] || active_provider=openai
  if [[ -x "$profiles_tool" ]]; then
    credential_status="$($profiles_tool status codex "$codex_home")"
  else
    credential_status="credential_profile_id=\ncredential_profile_name=\ncredential_profile_valid=no\ncredential_profile_key=missing\ncredential_profile_reason=Credential Profile helper 缺失：$profiles_tool\ncredential_profile_legacy=no"
  fi
  credential_valid="$(print -r -- "$credential_status" | awk -F= '$1 == "credential_profile_valid" { print $2 }')"
  credential_reason="$(print -r -- "$credential_status" | awk -F= '$1 == "credential_profile_reason" { sub(/^[^=]*=/, ""); print }')"
  consistent=yes
  inconsistency_reason=""
  if [[ "$active_provider" != deepseek ]]; then
    current_state=chatgpt
    state_label="ChatGPT"
  elif [[ "$active_model" == deepseek-v4-pro ]] && proxy_ready && [[ "$credential_valid" == yes ]]; then
    current_state=deepseek
    state_label="DeepSeek V4 Pro"
  else
    current_state=inconsistent
    state_label="配置不一致"
    consistent=no
    if [[ "$active_model" != deepseek-v4-pro ]]; then
      inconsistency_reason="Codex DeepSeek 模型不是 deepseek-v4-pro"
    elif ! proxy_ready; then
      inconsistency_reason="DeepSeek Responses Proxy 未运行"
    else
      inconsistency_reason="$credential_reason"
    fi
  fi
  print "current_state=$current_state"
  print "state_label=$state_label"
  print "state_consistent=$consistent"
  print "inconsistency_reason=$inconsistency_reason"
  print "provider=$active_provider"
  print "model=${active_model:-built-in-default}"
  print "codex_reasoning_effort=${codex_effort:-built-in-default}"
  print "reasoning_effort_mode=per-request"
  print "reasoning_effort_mapping=high=high,xhigh=max"
  print "service_tier=${$(root_value service_tier):-built-in-default}"
  print "model_catalog=${catalog:-built-in}"
  provider_exists && print "deepseek_provider=present" || print "deepseek_provider=MISSING"
  print -r -- "$credential_status"
  [[ "$(print -r -- "$credential_status" | awk -F= '$1 == "credential_profile_key" { print $2 }')" == present ]] \
    && print "deepseek_keychain=present" || print "deepseek_keychain=missing"
  proxy_ready && print "deepseek_proxy=running" || print "deepseek_proxy=stopped"
}

[[ $# -ge 1 ]] || usage
mode="$1"
shift
credential_ref=""
case "$mode" in
  status)
    [[ $# -eq 0 ]] || usage
    [[ -f "$config_file" ]] || { print -u2 "Missing $config_file"; exit 1; }
    show_status
    exit 0
    ;;
  chatgpt)
    [[ $# -eq 0 ]] || usage
    ;;
  deepseek)
    if [[ $# -eq 2 && "$1" == --credential ]]; then
      credential_ref="$2"
    elif [[ $# -ne 0 ]]; then
      usage
    fi
    ;;
  *) usage ;;
esac

[[ -f "$config_file" ]] || { print -u2 "Missing $config_file"; exit 1; }
[[ -x "$codex_bin" ]] || { print -u2 "Missing Codex CLI"; exit 1; }
provider_exists || { print -u2 "Refusing to switch: [model_providers.deepseek] is missing"; exit 1; }

if [[ "$mode" == deepseek ]]; then
  [[ -f "$catalog_file" ]] || { print -u2 "Missing $catalog_file"; exit 1; }
  [[ -f "$proxy_plist" ]] || { print -u2 "Missing DeepSeek proxy LaunchAgent: $proxy_plist"; exit 1; }
  [[ -x "$profiles_tool" ]] || { print -u2 "Missing Credential Profile helper: $profiles_tool"; exit 1; }
fi

if ! mkdir "$lock_dir" 2>/dev/null; then
  print -u2 "Another provider switch is already running."
  exit 1
fi

tmp_prefix=""
tmp_candidate=""
tmp_profile=""
tmp_chatgpt_state=""
verify_home=""
config_applied=0
profile_applied=0
chatgpt_state_applied=0
switch_committed=0
config_backup=""
profile_backup=""
profile_existed=0
chatgpt_state_backup=""
chatgpt_state_existed=0

cleanup() {
  set +e
  if [[ "$switch_committed" -eq 0 ]]; then
    if [[ "$config_applied" -eq 1 && -n "$config_backup" && -f "$config_backup" ]]; then
      atomic_restore_file "$config_backup" "$config_file"
    fi
    if [[ "$profile_applied" -eq 1 ]]; then
      if [[ "$profile_existed" -eq 1 && -n "$profile_backup" && -f "$profile_backup" ]]; then
        atomic_restore_file "$profile_backup" "$profile_file"
      else
        rm -f "$profile_file"
        fsync_directory "${profile_file:h}"
      fi
    fi
    if [[ "$chatgpt_state_applied" -eq 1 ]]; then
      if [[ "$chatgpt_state_existed" -eq 1 && -n "$chatgpt_state_backup" && -f "$chatgpt_state_backup" ]]; then
        atomic_restore_file "$chatgpt_state_backup" "$chatgpt_state"
      else
        rm -f "$chatgpt_state"
        fsync_directory "${chatgpt_state:h}"
      fi
    fi
  fi
  [[ -n "$tmp_prefix" && -e "$tmp_prefix" ]] && rm -f "$tmp_prefix"
  [[ -n "$tmp_candidate" && -e "$tmp_candidate" ]] && rm -f "$tmp_candidate"
  [[ -n "$tmp_profile" && -e "$tmp_profile" ]] && rm -f "$tmp_profile"
  [[ -n "$tmp_chatgpt_state" && -e "$tmp_chatgpt_state" ]] && rm -f "$tmp_chatgpt_state"
  [[ -n "$verify_home" && -d "$verify_home" ]] && rm -rf "$verify_home"
  rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

current_provider="$(root_value model_provider)"
if [[ "$mode" == deepseek && "$current_provider" != deepseek ]]; then
  tmp_chatgpt_state="$(mktemp "$codex_home/.chatgpt.activation.toml.candidate.XXXXXX")"
  awk '
    /^[[:space:]]*\[/ { exit }
    /^[[:space:]]*model[[:space:]]*=/ { print }
    /^[[:space:]]*model_reasoning_effort[[:space:]]*=/ { print }
    /^[[:space:]]*service_tier[[:space:]]*=/ { print }
  ' "$config_file" > "$tmp_chatgpt_state"
  chmod 600 "$tmp_chatgpt_state"
fi

tmp_prefix="$(mktemp "$codex_home/.config.prefix.XXXXXX")"
tmp_candidate="$(mktemp "$codex_home/.config.candidate.XXXXXX")"

if [[ "$mode" == deepseek ]]; then
  tmp_profile="$(mktemp "$codex_home/.credential-profiles.candidate.XXXXXX")"
  profile_args=(candidate codex "$codex_home" --output "$tmp_profile")
  [[ -n "$credential_ref" ]] && profile_args+=(--credential "$credential_ref")
  credential_info="$($profiles_tool "${profile_args[@]}")"
  IFS=$'\t' read -r selected_profile_id selected_profile_name <<< "$credential_info"
  print 'model = "deepseek-v4-pro"' > "$tmp_prefix"
  print 'model_provider = "deepseek"' >> "$tmp_prefix"
  print "model_catalog_json = \"$catalog_file\"" >> "$tmp_prefix"
else
  [[ -f "$chatgpt_state" ]] || { print -u2 "Missing saved ChatGPT activation state"; exit 1; }
  cp "$chatgpt_state" "$tmp_prefix"
fi

awk -v prefix_file="$tmp_prefix" '
  function emit_prefix( line, rc) {
    while ((rc = getline line < prefix_file) > 0) print line
    close(prefix_file)
    emitted=1
  }
  BEGIN { in_table=0; emitted=0 }
  !in_table && /^[[:space:]]*(model|model_provider|model_reasoning_effort|model_catalog_json|service_tier|forced_login_method|preferred_auth_method)[[:space:]]*=/ {
    if (!emitted) emit_prefix()
    next
  }
  !in_table && /^[[:space:]]*\[/ {
    if (!emitted) emit_prefix()
    in_table=1
  }
  { print }
  END { if (!emitted) emit_prefix() }
' "$config_file" > "$tmp_candidate"
chmod 600 "$tmp_candidate"

current_status="$(show_status)"
current_state="$(print -r -- "$current_status" | awk -F= '$1 == "current_state" { print $2 }')"
current_profile_id="$(print -r -- "$current_status" | awk -F= '$1 == "credential_profile_id" { print $2 }')"
if [[ "$mode" == chatgpt && "$current_state" == chatgpt ]]; then
  switch_committed=1
  print "ChatGPT/OpenAI is already active; no files changed."
  print -r -- "$current_status"
  exit 0
fi
if [[ "$mode" == deepseek && "$current_state" == deepseek && "$current_profile_id" == "$selected_profile_id" ]]; then
  switch_committed=1
  print "DeepSeek V4 Pro with Credential Profile $selected_profile_name is already active; no files changed."
  print -r -- "$current_status"
  exit 0
fi

mkdir -p "$backup_dir"
chmod 700 "$backup_dir"
stamp="$(date '+%Y%m%d-%H%M%S')-$$"
config_backup="$backup_dir/config.toml.$stamp.before-$mode.bak"
cp -p "$config_file" "$config_backup"

if [[ "$mode" == deepseek ]]; then
  if [[ -f "$profile_file" ]]; then
    profile_existed=1
    profile_backup="$backup_dir/deepseek-credential-profiles.json.$stamp.before-$mode.bak"
    cp -p "$profile_file" "$profile_backup"
  fi
  if [[ -n "$tmp_chatgpt_state" && -f "$chatgpt_state" ]]; then
    chatgpt_state_existed=1
    chatgpt_state_backup="$backup_dir/chatgpt.activation.toml.$stamp.before-$mode.bak"
    cp -p "$chatgpt_state" "$chatgpt_state_backup"
  fi
  mv -f "$tmp_profile" "$profile_file"
  tmp_profile=""
  chmod 600 "$profile_file"
  fsync_directory "${profile_file:h}"
  profile_applied=1
fi

verify_home="$(mktemp -d "${TMPDIR:-/tmp}/codex-provider-verify.XXXXXX")"
cp "$tmp_candidate" "$verify_home/config.toml"
CODEX_HOME="$verify_home" "$codex_bin" debug models >/dev/null

if [[ "$mode" == deepseek ]]; then
  ensure_proxy
  health_summary="$(check_upstream)"
fi

if [[ -n "$tmp_chatgpt_state" ]]; then
  mv -f "$tmp_chatgpt_state" "$chatgpt_state"
  tmp_chatgpt_state=""
  chmod 600 "$chatgpt_state"
  fsync_directory "${chatgpt_state:h}"
  chatgpt_state_applied=1
fi

mv -f "$tmp_candidate" "$config_file"
tmp_candidate=""
chmod 600 "$config_file"
fsync_directory "${config_file:h}"
config_applied=1

provider_exists || { print -u2 "Post-switch invariant failed: DeepSeek provider disappeared."; exit 1; }

if [[ "$mode" == deepseek ]]; then
  models_check="$("$codex_bin" debug models 2>/dev/null)"
  [[ "$models_check" == *'"slug":"deepseek-v4-pro"'* ]] || {
    print -u2 "Codex model catalog does not contain deepseek-v4-pro."
    exit 1
  }
  [[ "$(root_value model_provider)" == deepseek ]] || {
    print -u2 "Codex configuration does not match requested DeepSeek provider."
    exit 1
  }
  [[ "$(root_value model)" == deepseek-v4-pro ]] || {
    print -u2 "Codex configuration does not match requested DeepSeek model."
    exit 1
  }
  verified_profile_id="$(show_status | awk -F= '$1 == "credential_profile_id" { print $2 }')"
  [[ "$verified_profile_id" == "$selected_profile_id" ]] || {
    print -u2 "Codex Credential Profile does not match the requested profile."
    exit 1
  }
  actual_state="$(show_status | awk -F= '$1 == "current_state" { print $2 }')"
  [[ "$actual_state" == deepseek ]] || {
    print -u2 "Post-switch state is inconsistent: expected deepseek, got ${actual_state:-unknown}."
    exit 1
  }
  print "DeepSeek V4 Pro is active for new sessions."
  print "credential_profile_id=$selected_profile_id"
  print "credential_profile_name=$selected_profile_name"
  print "reasoning_effort_mode=per-request"
  print "reasoning_effort_mapping=high=high,xhigh=max"
  print -r -- "$health_summary"
else
  [[ "$(root_value model_provider)" != deepseek ]] || {
    print -u2 "ChatGPT/OpenAI activation still points to DeepSeek."
    exit 1
  }
  [[ -z "$(root_value model_catalog_json)" ]] || {
    print -u2 "ChatGPT/OpenAI activation unexpectedly retained the DeepSeek model catalog."
    exit 1
  }
  print "ChatGPT/OpenAI is active for new sessions."
fi

switch_committed=1
print "Backup: $config_backup"
print "Provider configuration switch completed."
show_status
