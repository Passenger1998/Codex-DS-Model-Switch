def _model_entries(mode: str) -> list[dict[str, Any]]:
    pro = {
        "anthropicFamilyTier": "opus",
        "name": PRO_MODEL,
        "labelOverride": "DeepSeek V4 Pro",
    }
    flash = {
        "anthropicFamilyTier": "sonnet",
        "name": FLASH_MODEL,
        "labelOverride": "DeepSeek V4 Flash",
    }
    if mode == "deepseek-pro":
        return [pro, flash]
    if mode == "deepseek-flash":
        return [flash, pro]
    raise ClaudeProviderError(f"未知模式：{mode}")


def deepseek_desktop_config(
    original: dict[str, Any], mode: str, helper_command: str
) -> dict[str, Any]:
    updated = dict(original)
    updated.update(
        {
            "inferenceGatewayBaseUrl": DEEPSEEK_ANTHROPIC_BASE_URL,
            "inferenceCredentialHelper": helper_command,
            "inferenceModels": _model_entries(mode),
            "inferenceProvider": "gateway",
            "inferenceCredentialKind": "helper-script",
            "inferenceGatewayAuthScheme": "bearer",
            "modelDiscoveryEnabled": False,
        }
    )
    return updated


def _tier_for_model(entry: Any) -> tuple[str, str]:
    if isinstance(entry, str):
        tier, name = "", entry
    elif isinstance(entry, dict):
        tier = str(entry.get("anthropicFamilyTier") or "")
        name = str(entry.get("name") or "")
    else:
        return "", ""
    if not tier:
        tier = "opus" if name == PRO_MODEL else "sonnet" if name == FLASH_MODEL else ""
    return tier, name


def classify_desktop_config(
    config: dict[str, Any], expected_helper: str
) -> tuple[str, str, bool, str, str]:
    """Return state, default model, consistent, reason, effective auth scheme."""
    if config.get("inferenceProvider") != "gateway":
        return "official", "", True, "", ""
    if config.get("inferenceGatewayBaseUrl") != DEEPSEEK_ANTHROPIC_BASE_URL:
        return "inconsistent", "", False, "Desktop Gateway URL 不正确", ""
    if config.get("inferenceCredentialKind") != "helper-script":
        return "inconsistent", "", False, "Desktop Credential 不是 Helper script", ""
    if str(config.get("inferenceCredentialHelper") or "") != expected_helper:
        return "inconsistent", "", False, "Desktop Helper 路径与已验证配置不一致", ""
    auth_scheme = str(config.get("inferenceGatewayAuthScheme") or "bearer")
    if auth_scheme != "bearer":
        return "inconsistent", "", False, "Desktop auth scheme 不是 bearer", auth_scheme
    if config.get("modelDiscoveryEnabled") not in (None, False):
        return "inconsistent", "", False, "Desktop Model discovery 未关闭", auth_scheme
    entries = config.get("inferenceModels")
    if not isinstance(entries, list) or not entries:
        return "inconsistent", "", False, "Desktop 模型列表为空", auth_scheme
    mapped = {_tier_for_model(entry) for entry in entries}
    if ("opus", PRO_MODEL) not in mapped or ("sonnet", FLASH_MODEL) not in mapped:
        return "inconsistent", "", False, "Desktop 模型列表缺少 Opus/Sonnet 映射", auth_scheme
    tier, model = _tier_for_model(entries[0])
    if (tier, model) == ("opus", PRO_MODEL):
        return "deepseek-pro", model, True, "", auth_scheme
    if (tier, model) == ("sonnet", FLASH_MODEL):
        return "deepseek-flash", model, True, "", auth_scheme
    return "inconsistent", model, False, "Desktop 模型列表首项不是受支持的默认 tier", auth_scheme


def _valid_config_id(value: Any) -> str | None:
    text = str(value or "")
    return text if CONFIG_ID_PATTERN.fullmatch(text) else None


def _read_desktop_files(
    support: Path,
) -> tuple[dict[str, Any], dict[str, Any], str | None, dict[str, Any]]:
    desktop = read_json_object(
        desktop_config_path(support), "Claude-3p/claude_desktop_config.json"
    )
    meta = read_json_object(
        config_library_meta_path(support), "Claude-3p/configLibrary/_meta.json"
    )
    config_id = _valid_config_id(meta.get("appliedId"))
    active = (
        read_json_object(
            config_library_entry_path(support, config_id),
            f"Claude-3p/configLibrary/{config_id}.json",
        )
        if config_id
        else {}
    )
    return desktop, meta, config_id, active


def classify_current(
    claude_home: Path, support: Path, helper_command: str
) -> dict[str, str]:
    reasons: list[str] = []
    try:
        settings = read_settings(settings_path(claude_home))
        cli_state, _, cli_ok, cli_reason = classify_env(env_of(settings))
        if not cli_ok:
            reasons.append(cli_reason)
        cli_helper = helper_of(settings)
    except ClaudeProviderError as exc:
        cli_state, cli_helper = "inconsistent", None
        reasons.append(str(exc))

    try:
        desktop, _, config_id, active = _read_desktop_files(support)
        deployment = str(desktop.get("deploymentMode") or "")
        active_state, default_model, active_ok, active_reason, auth_scheme = (
            classify_desktop_config(active, helper_command)
        )
        if deployment == "1p":
            desktop_state, desktop_ok = "default", True
        elif active_state in ("deepseek-pro", "deepseek-flash"):
            desktop_state, desktop_ok = active_state, active_ok
        elif deployment == "3p":
            desktop_state, desktop_ok = "inconsistent", False
            reasons.append(active_reason or "deploymentMode=3p，但没有可用的活动 3P 配置")
        elif active_state == "official":
            desktop_state, desktop_ok = "default", True
        else:
            desktop_state, desktop_ok = "inconsistent", False
            reasons.append(active_reason)
    except ClaudeProviderError as exc:
        deployment, config_id, default_model, auth_scheme = "", None, "", ""
        desktop_state, desktop_ok = "inconsistent", False
        reasons.append(str(exc))

    if cli_state in ("deepseek-pro", "deepseek-flash") and not cli_helper:
        cli_state = "inconsistent"
        reasons.append("直接 CLI 的 apiKeyHelper 缺失")
    credential = active_status(
        "claude", claude_home, lambda service, account: keychain_ready(service, account)
    )
    if desktop_ok and cli_state == desktop_state:
        state, consistent = desktop_state, True
    else:
        state, consistent = "inconsistent", False
        if cli_state != desktop_state:
            reasons.append(f"Desktop={desktop_state}，直接 CLI={cli_state}")
    if state in ("deepseek-pro", "deepseek-flash") and credential["valid"] != "yes":
        state, consistent = "inconsistent", False
        reasons.append(credential["reason"])
    return {
        "state": state,
        "label": MODE_LABELS.get(state, "配置不一致"),
        "consistent": "yes" if consistent else "no",
        "reason": "；".join(dict.fromkeys(reason for reason in reasons if reason)),
        "deployment_mode": deployment,
        "desktop_provider": (
            "gateway" if desktop_state in ("deepseek-pro", "deepseek-flash") else "anthropic"
        ),
        "desktop_default_model": default_model,
        "desktop_auth_scheme": auth_scheme,
        "active_config_id": config_id or "",
        "credential_profile_id": credential["id"],
        "credential_profile_name": credential["name"],
        "credential_profile_key": credential["key"],
        "credential_profile_valid": credential["valid"],
        "credential_profile_reason": credential["reason"],
    }


# ---------------------------------------------------------------------------
# Detection and Keychain checks.  Keychain values are never requested.


def _plist_version(plist_path: Path, key: str = "CFBundleShortVersionString") -> str:
    try:
        result = subprocess.run(
            ["/usr/libexec/PlistBuddy", "-c", f"Print :{key}", str(plist_path)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return (result.stdout or "").strip() if result.returncode == 0 else ""


def detect_claude_desktop() -> tuple[bool, str, str]:
    for candidate in (
        Path("/Applications/Claude.app"),
        Path.home() / "Applications/Claude.app",
    ):
        info = candidate / "Contents/Info.plist"
        if candidate.is_dir() and info.is_file():
            version = _plist_version(info)
            if version:
                return True, version, str(candidate)
    return False, "", ""


def detect_bundled_claude_code() -> tuple[bool, str, str]:
    roots = (
        Path.home() / "Library/Application Support/Claude-3p/claude-code",
        Path.home() / "Library/Application Support/Claude/claude-code",
    )
    for root in roots:
        if not root.is_dir():
            continue
        for version_dir in sorted(root.iterdir(), reverse=True):
            binary = version_dir / "claude.app/Contents/MacOS/claude"
            if binary.is_file() and os.access(binary, os.X_OK):
                version = _plist_version(
                    version_dir / "claude.app/Contents/Info.plist"
                ) or version_dir.name
                return True, version, str(binary)
    return False, "", ""


def _try_version(binary: str) -> str:
    try:
        result = subprocess.run(
            [binary, "--version"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    output = (result.stdout or "").strip()
    return output.splitlines()[0][:200] if result.returncode == 0 and output else ""


def _is_managed_wrapper(binary: str) -> bool:
    try:
        with open(binary, "r", encoding="utf-8", errors="replace") as handle:
            return "claude-provider: managed launch wrapper" in handle.read(256)
    except OSError:
        return False


def detect_claude_cli(claude_home: Path) -> tuple[bool, str, str]:
    candidates: list[str] = []
    found = shutil.which("claude")
    if found:
        candidates.append(found)
    candidates.extend(
        [
            str(claude_home / "local/claude"),
            str(Path.home() / ".local/bin/claude"),
            str(Path.home() / ".npm-global/bin/claude"),
            "/usr/local/bin/claude",
            "/opt/homebrew/bin/claude",
        ]
    )
    seen: set[str] = set()
    for candidate in candidates:
        resolved = str(Path(candidate).expanduser())
        if resolved in seen or not os.path.isfile(resolved):
            continue
        seen.add(resolved)
        if _is_managed_wrapper(resolved) or not os.access(resolved, os.X_OK):
            continue
        return True, _try_version(resolved), resolved
    return False, "", ""


def keychain_ready(
    service: str = KEYCHAIN_SERVICE, account: str = KEYCHAIN_ACCOUNT
) -> bool:
    try:
        result = subprocess.run(
            [
                "/usr/bin/security",
                "find-generic-password",
                "-s",
                service,
                "-a",
                account,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        return False
    return result.returncode == 0


# ---------------------------------------------------------------------------
# Lock, snapshots, backups, transaction


@contextmanager
def provider_lock(claude_home: Path):
    path = lock_path(claude_home)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    handle = path.open("a+")
    try:
        import fcntl

        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise ClaudeProviderError("另一个 Claude 配置切换正在进行中") from exc
        yield
    finally:
        try:
            import fcntl

            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        except (ImportError, OSError):
            pass
        handle.close()


@contextmanager
def credential_directory_lock(claude_home: Path):
    """Coordinate Provider transactions with GUI Keychain/profile edits."""
    claude_home.mkdir(parents=True, exist_ok=True, mode=0o700)
    path = claude_home / ".provider-switch.lock"
    try:
        path.mkdir(parents=False)
    except FileExistsError as exc:
        raise ClaudeProviderError("另一个 Credential Profile 或 Provider 事务正在运行") from exc
    try:
        yield
    finally:
        try:
            path.rmdir()
        except OSError:
            pass


def _sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _snapshot_file_record(snapshot: Path, tag: str, source: Path) -> dict[str, Any]:
    if not source.exists():
        return {"exists": False}
    data = source.read_bytes()
    backup_name = f"{tag}.original"
    atomic_write_bytes(snapshot / backup_name, data)
    return {"exists": True, "backup": backup_name, "sha256": _sha256(data)}


def capture_official_snapshot(
    claude_home: Path, support: Path, managed_config_id: str
) -> Path:
    root = snapshot_root(claude_home)
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    name = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}-{time.time_ns()}"
    snapshot = root / name
    snapshot.mkdir(mode=0o700)
    sources = {
        "settings": settings_path(claude_home),
        "desktop": desktop_config_path(support),
        "meta": config_library_meta_path(support),
        "active": config_library_entry_path(support, managed_config_id),
    }
    manifest = {
        "version": SNAPSHOT_VERSION,
        "managedConfigId": managed_config_id,
        "files": {
            tag: _snapshot_file_record(snapshot, tag, source)
            for tag, source in sources.items()
        },
    }
    atomic_write_json(snapshot / "manifest.json", manifest)
    atomic_write_json(
        snapshot_pointer_path(claude_home),
        {"version": SNAPSHOT_VERSION, "directory": name},
    )
    return snapshot


def load_official_snapshot(claude_home: Path) -> dict[str, Any] | None:
    pointer_path = snapshot_pointer_path(claude_home)
    if not pointer_path.exists():
        return None
    pointer = read_json_object(pointer_path, pointer_path.name)
    if pointer.get("version") != SNAPSHOT_VERSION:
        raise ClaudeProviderError("Claude 官方配置快照版本不受支持")
    directory = str(pointer.get("directory") or "")
    if not directory or Path(directory).name != directory:
        raise ClaudeProviderError("Claude 官方配置快照路径非法")
    snapshot = snapshot_root(claude_home) / directory
    manifest = read_json_object(snapshot / "manifest.json", "官方配置快照 manifest")
    if manifest.get("version") != SNAPSHOT_VERSION:
        raise ClaudeProviderError("Claude 官方配置快照 manifest 版本不受支持")
    records = manifest.get("files")
    if not isinstance(records, dict):
        raise ClaudeProviderError("Claude 官方配置快照缺少 files")
    loaded: dict[str, bytes | None] = {}
    for tag in ("settings", "desktop", "meta", "active"):
        record = records.get(tag)
        if not isinstance(record, dict):
            raise ClaudeProviderError(f"Claude 官方配置快照缺少 {tag}")
        if record.get("exists") is not True:
            loaded[tag] = None
            continue
        backup_name = str(record.get("backup") or "")
        if Path(backup_name).name != backup_name:
            raise ClaudeProviderError("Claude 官方配置快照文件名非法")
        data = (snapshot / backup_name).read_bytes()
        if _sha256(data) != record.get("sha256"):
            raise ClaudeProviderError(f"Claude 官方配置快照 {tag} 校验失败")
        loaded[tag] = data
    config_id = _valid_config_id(manifest.get("managedConfigId"))
    if not config_id:
        raise ClaudeProviderError("Claude 官方配置快照缺少活动配置 ID")
    return {"directory": snapshot, "managed_config_id": config_id, "files": loaded}


def _parse_snapshot_object(data: bytes | None, label: str) -> dict[str, Any]:
    if data is None:
        return {}
    try:
        value = json.loads(data.decode())
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ClaudeProviderError(f"官方快照中的 {label} 无效") from exc
    if not isinstance(value, dict):
        raise ClaudeProviderError(f"官方快照中的 {label} 顶层不是对象")
    return value


def _restore_keys(
    current: dict[str, Any], baseline: dict[str, Any], keys: tuple[str, ...]
) -> dict[str, Any]:
    updated = dict(current)
    for key in keys:
        if key in baseline:
            updated[key] = baseline[key]
        else:
            updated.pop(key, None)
    return updated


def _make_backup(claude_home: Path, path: Path, tag: str, data: bytes) -> Path:
    directory = backup_dir(claude_home)
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    stamp = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}-{time.time_ns()}"
    target = directory / f"{tag}.{stamp}.bak"
    atomic_write_bytes(target, data)
    return target


def _commit_transaction(
    claude_home: Path,
    actions: dict[Path, bytes | None],
    verify: Callable[[], None],
) -> list[Path]:
    originals = {
        path: path.read_bytes() if path.exists() else None for path in actions
    }
    changed = {
        path: expected
        for path, expected in actions.items()
        if originals[path] != expected
    }
    if not changed:
        verify()
        return []
    backups: list[Path] = []
    for index, (path, original) in enumerate(changed.items()):
        if original is not None:
            backups.append(
                _make_backup(claude_home, path, f"{index}-{path.name}", original)
            )
    try:
        for path, expected in changed.items():
            atomic_remove(path) if expected is None else atomic_write_bytes(path, expected)
        for path, expected in changed.items():
            actual = path.read_bytes() if path.exists() else None
            if actual != expected:
                raise ClaudeProviderError(f"写后校验失败：{path}")
        verify()
    except BaseException as exc:
        rollback_errors: list[str] = []
        for path, original in reversed(list(originals.items())):
            try:
                atomic_remove(path) if original is None else atomic_write_bytes(path, original)
            except BaseException as rollback_exc:
                rollback_errors.append(f"{path}: {rollback_exc}")
        if rollback_errors:
            raise ClaudeProviderError(
                f"切换失败且回滚不完整：{exc}；" + "；".join(rollback_errors)
            ) from exc
        raise
    return backups


def _select_config_id(meta: dict[str, Any]) -> str:
    return _valid_config_id(meta.get("appliedId")) or str(uuid.uuid4())


def _meta_with_active_config(meta: dict[str, Any], config_id: str) -> dict[str, Any]:
    updated = dict(meta)
    entries = updated.get("entries")
    safe_entries = list(entries) if isinstance(entries, list) else []
    if not any(
        isinstance(item, dict) and item.get("id") == config_id
        for item in safe_entries
    ):
        safe_entries.append({"id": config_id, "name": "Codex 模型切换器 · DeepSeek"})
    updated["appliedId"] = config_id
    updated["entries"] = safe_entries
    return updated


def switch_mode(
    mode: str,
    claude_home: Path,
    *,
    require_keychain: bool = True,
    require_helper: bool = True,
    claude_3p_support: Path | None = None,
    claude_app_support: Path | None = None,
    helper_command: str | None = None,
    proxy_env: dict[str, str] | None = None,
    credential_profile: str | None = None,
) -> dict[str, str]:
    if mode not in MODE_LABELS:
        raise ClaudeProviderError(f"未知模式：{mode}")
    support = claude_3p_support or claude_app_support or resolve_claude_3p_support()
    helper = helper_command or credential_helper_command()
    if mode != "default" and require_helper:
        if not os.path.isfile(helper) or not os.access(helper, os.X_OK):
            raise ClaudeProviderError(f"Claude DeepSeek Helper 不存在或不可执行：{helper}")

    with credential_directory_lock(claude_home), provider_lock(claude_home):
        path = settings_path(claude_home)
        desktop_path_ = desktop_config_path(support)
        meta_path = config_library_meta_path(support)
        settings = read_settings(path)
        desktop, meta, _, _ = _read_desktop_files(support)
        current = classify_current(claude_home, support, helper)

        if mode != "default":
            try:
                profile_state, _ = load_effective_state(
                    "claude",
                    claude_home,
                    lambda service, account: keychain_ready(service, account),
                )
                selected_profile = resolve_profile(profile_state, credential_profile)
            except CredentialProfileError as exc:
                raise ClaudeProviderError(str(exc)) from exc
            if require_keychain and not keychain_ready(KEYCHAIN_SERVICE, selected_profile["id"]):
                raise ClaudeProviderError(
                    f"Credential Profile {selected_profile['displayName']} 的 Keychain 条目缺失"
                )
            profile_state = state_with_active(profile_state, selected_profile["id"])
            config_id = _select_config_id(meta)
            active_path = config_library_entry_path(support, config_id)
            active = read_json_object(active_path, f"configLibrary/{config_id}.json")
            if current["state"] == "default" and current["consistent"] == "yes":
                capture_official_snapshot(claude_home, support, config_id)
            new_desktop = dict(desktop)
            new_desktop["deploymentMode"] = "3p"
            actions: dict[Path, bytes | None] = {
                path: _json_bytes(
                    apply_deepseek_settings(settings, mode, helper, proxy_env)
                ),
                desktop_path_: _json_bytes(new_desktop),
                meta_path: _json_bytes(_meta_with_active_config(meta, config_id)),
                active_path: _json_bytes(
                    deepseek_desktop_config(active, mode, helper)
                ),
                profile_path(claude_home): credential_state_bytes(profile_state),
            }
        else:
            snapshot = load_official_snapshot(claude_home)
            if snapshot is None:
                configured_helper = helper_of(settings) or ""
                needs_cli_cleanup = (
                    classify_env(env_of(settings))[0] != "default"
                    or configured_helper == helper
                    or KEYCHAIN_SERVICE in configured_helper
                )
                new_settings = (
                    restore_official_settings(settings, {})
                    if needs_cli_cleanup
                    else settings
                )
                new_desktop = dict(desktop)
                new_desktop["deploymentMode"] = "1p"
                actions = {
                    path: _json_bytes(new_settings),
                    desktop_path_: _json_bytes(new_desktop),
                }
            else:
                files = snapshot["files"]
                baseline_settings = _parse_snapshot_object(files["settings"], "settings")
                baseline_desktop = _parse_snapshot_object(files["desktop"], "desktop")
                baseline_meta = _parse_snapshot_object(files["meta"], "meta")
                baseline_active = _parse_snapshot_object(files["active"], "active")
                config_id = str(snapshot["managed_config_id"])
                active_path = config_library_entry_path(support, config_id)
                current_active = read_json_object(active_path, f"configLibrary/{config_id}.json")
                new_settings = restore_official_settings(settings, baseline_settings)
                new_desktop = _restore_keys(desktop, baseline_desktop, ("deploymentMode",))
                new_meta = _restore_keys(meta, baseline_meta, ("appliedId", "entries"))
                new_active = _restore_keys(
                    current_active, baseline_active, DESKTOP_MANAGED_KEYS
                )
                actions = {
                    path: _json_bytes(new_settings) if new_settings else None,
                    desktop_path_: _json_bytes(new_desktop) if new_desktop else None,
                    meta_path: _json_bytes(new_meta) if new_meta else None,
                    active_path: _json_bytes(new_active) if new_active else None,
                }

        def verify_target() -> None:
            final = classify_current(claude_home, support, helper)
            if final["consistent"] != "yes" or final["state"] != mode:
                reason = final["reason"] or f"实际状态为 {final['state']}"
                raise ClaudeProviderError(f"切换后真实配置校验失败：{reason}")

        backups = _commit_transaction(claude_home, actions, verify_target)
    return {
        "state": mode,
        "state_label": MODE_LABELS[mode],
        "backup": str(backups[0]) if backups else "",
        "credential_profile_id": selected_profile["id"] if mode != "default" else "",
        "credential_profile_name": selected_profile["displayName"] if mode != "default" else "",
    }


