def status(
    claude_home: Path,
    *,
    claude_3p_support: Path | None = None,
    claude_app_support: Path | None = None,
    environment: dict[str, str] | None = None,
    helper_command: str | None = None,
) -> str:
    support = (
        claude_3p_support
        or claude_app_support
        or resolve_claude_3p_support(environment)
    )
    helper = helper_command or credential_helper_command(environment)
    current = classify_current(claude_home, support, helper)
    desktop_installed, desktop_version, desktop_path_ = detect_claude_desktop()
    engine_installed, engine_version, engine_path = detect_bundled_claude_code()
    cli_installed, cli_version, cli_path = detect_claude_cli(claude_home)
    auth = current["credential_profile_key"] == "present"
    helper_ready = os.path.isfile(helper) and os.access(helper, os.X_OK)
    try:
        settings = read_settings(settings_path(claude_home))
        env = env_of(settings)
        api_helper_present = bool(helper_of(settings))
    except ClaudeProviderError:
        env, api_helper_present = {}, False
    system_proxy = read_system_proxy_env()
    lines = [
        f"current_state={current['state']}",
        f"state_label={current['label']}",
        f"state_consistent={current['consistent']}",
        f"inconsistency_reason={current['reason']}",
        f"desktop_installed={'yes' if desktop_installed else 'no'}",
        f"desktop_version={desktop_version}",
        f"desktop_path={desktop_path_}",
        f"claude_code_installed={'yes' if engine_installed else 'no'}",
        f"claude_code_version={engine_version}",
        f"claude_code_path={engine_path}",
        f"cli_installed={'yes' if cli_installed else 'no'}",
        f"cli_version={cli_version}",
        f"cli_path={cli_path}",
        f"settings_path={settings_path(claude_home)}",
        f"claude_3p_support_path={support}",
        f"desktop_config_path={desktop_config_path(support)}",
        f"config_library_meta_path={config_library_meta_path(support)}",
        f"active_config_id={current['active_config_id']}",
        f"deployment_mode={current['deployment_mode']}",
        f"desktop_provider={current['desktop_provider']}",
        f"desktop_default_model={current['desktop_default_model']}",
        f"desktop_auth_scheme={current['desktop_auth_scheme']}",
        f"model_discovery={'disabled' if current['desktop_provider'] == 'gateway' else ''}",
        f"base_url={env.get('ANTHROPIC_BASE_URL', '')}",
        f"model={env.get('ANTHROPIC_MODEL', '')}",
        f"env_http_proxy={env.get('HTTP_PROXY', '')}",
        f"env_https_proxy={env.get('HTTPS_PROXY', '')}",
        f"system_http_proxy={system_proxy.get('HTTP_PROXY', '')}",
        f"system_https_proxy={system_proxy.get('HTTPS_PROXY', '')}",
        f"api_key_helper={'present' if api_helper_present else 'absent'}",
        f"helper_ready={'yes' if helper_ready else 'no'}",
        f"auth={'keychain-helper' if auth else 'MISSING'}",
        f"keychain_service={KEYCHAIN_SERVICE}",
        f"credential_profile_id={current['credential_profile_id']}",
        f"credential_profile_name={current['credential_profile_name']}",
        f"credential_profile_key={current['credential_profile_key']}",
        f"credential_profile_valid={current['credential_profile_valid']}",
        f"credential_profile_reason={current['credential_profile_reason']}",
        f"backup_dir={backup_dir(claude_home)}",
    ]
    return "\n".join(lines) + "\n"


def main(argv: list[str]) -> int:
    import argparse

    parser = argparse.ArgumentParser(prog="claude-provider")
    parser.add_argument(
        "command", choices=["status", "default", "deepseek-pro", "deepseek-flash"]
    )
    parser.add_argument("--credential", help="Credential Profile ID or display name")
    args = parser.parse_args(argv)
    claude_home = resolve_claude_home()
    if args.command == "status":
        sys.stdout.write(status(claude_home))
        return 0
    try:
        result = switch_mode(
            args.command, claude_home, credential_profile=args.credential
        )
    except ClaudeProviderError as exc:
        sys.stderr.write(f"claude-provider: {exc}\n")
        return 1
    sys.stdout.write(f"current_state={result['state']}\n")
    sys.stdout.write(f"state_label={result['state_label']}\n")
    if result["backup"]:
        sys.stdout.write(f"backup={result['backup']}\n")
    if result["credential_profile_id"]:
        sys.stdout.write(f"credential_profile_id={result['credential_profile_id']}\n")
        sys.stdout.write(f"credential_profile_name={result['credential_profile_name']}\n")
    sys.stdout.write(
        "配置事务完成并已从真实 Desktop/CLI 配置复核。"
        "直接 CLI 的新会话立即生效；Claude Desktop 需重启后生效（GUI 会自动重启）。\n"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
