# ---------------------------------------------------------------------------
# JSON handling


def atomic_write_json(path: Path, data: Any) -> None:
    atomic_write_bytes(path, json.dumps(data, ensure_ascii=False, indent=2).encode() + b"\n")


def atomic_write_bytes(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=str(path.parent)
    )
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary_name, 0o600)
        os.replace(temporary_name, path)
    except BaseException:
        if os.path.exists(temporary_name):
            os.unlink(temporary_name)
        raise


def read_settings(path: Path) -> dict[str, Any]:
    """Return the parsed settings object, or {} when the file does not exist."""
    if not path.exists():
        return {}
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except json.JSONDecodeError as exc:
        raise ClaudeProviderError(f"settings.json 不是合法 JSON：{exc}") from exc
    if not isinstance(data, dict):
        raise ClaudeProviderError("settings.json 顶层必须是 JSON 对象")
    return data


def env_of(settings: dict[str, Any]) -> dict[str, str]:
    raw = settings.get("env")
    if raw is None:
        return {}
    if not isinstance(raw, dict):
        raise ClaudeProviderError('settings.json 的 "env" 字段必须是对象')
    return {str(key): str(value) for key, value in raw.items()}


def helper_of(settings: dict[str, Any]) -> str | None:
    raw = settings.get("apiKeyHelper")
    return None if raw is None else str(raw)


# ---------------------------------------------------------------------------
# macOS system proxy (same parsing design as Support/deepseek_responses_proxy.py)


def parse_scutil_proxy_output(text: str) -> dict[str, str]:
    """Parse ``scutil --proxy`` output into HTTP_PROXY / HTTPS_PROXY values.

    Mirrors ``parse_macos_proxy_settings`` from the Codex bridge: a proxy is
    only emitted when it is enabled, has a host, and has a valid port.
    IPv6 hosts are bracketed.  The endpoint fallback matches the bridge
    (https uses the http endpoint when no https proxy is configured, and
    vice versa).
    """
    values: dict[str, str] = {}
    for line in text.splitlines():
        match = re.match(r"^\s*([A-Za-z]+)\s*:\s*(.*?)\s*$", line)
        if match:
            values[match.group(1)] = match.group(2)

    def endpoint(prefix: str) -> str | None:
        if values.get(f"{prefix}Enable") != "1":
            return None
        host = values.get(f"{prefix}Proxy", "").strip()
        try:
            port = int(values.get(f"{prefix}Port", "0"))
        except ValueError:
            return None
        if not host or not 1 <= port <= 65535:
            return None
        formatted = f"[{host}]" if ":" in host and not host.startswith("[") else host
        return f"http://{formatted}:{port}"

    http_endpoint = endpoint("HTTP")
    https_endpoint = endpoint("HTTPS")
    env: dict[str, str] = {}
    http_proxy = http_endpoint or https_endpoint
    https_proxy = https_endpoint or http_endpoint
    if http_proxy:
        env["HTTP_PROXY"] = http_proxy
    if https_proxy:
        env["HTTPS_PROXY"] = https_proxy
    return env


def read_system_proxy_env() -> dict[str, str]:
    """Read the current macOS HTTP/HTTPS system proxy via scutil.

    Never raises; returns {} when there is no system proxy, scutil is
    unavailable, or the lookup fails.
    """
    if sys.platform != "darwin" or not os.path.isfile("/usr/sbin/scutil"):
        return {}
    try:
        result = subprocess.run(
            ["/usr/sbin/scutil", "--proxy"],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.SubprocessError):
        return {}
    if result.returncode != 0:
        return {}
    return parse_scutil_proxy_output(result.stdout)


# ---------------------------------------------------------------------------
# DeepSeek environment model mapping


def deepseek_env(model: str) -> dict[str, str]:
    return {
        "ANTHROPIC_BASE_URL": DEEPSEEK_ANTHROPIC_BASE_URL,
        "ANTHROPIC_MODEL": model,
        "ANTHROPIC_DEFAULT_OPUS_MODEL": PRO_MODEL,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": FLASH_MODEL,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": HAIKU_MODEL,
        "ANTHROPIC_SMALL_FAST_MODEL": HAIKU_MODEL,
        "CLAUDE_CODE_SUBAGENT_MODEL": model,
    }


def model_for_mode(mode: str) -> str | None:
    if mode == "deepseek-pro":
        return PRO_MODEL
    if mode == "deepseek-flash":
        return FLASH_MODEL
    return None


def classify_env(env: dict[str, str]) -> tuple[str, str, bool, str]:
    """Return (state, label, consistent, reason) for a settings ``env`` dict."""
    base = env.get("ANTHROPIC_BASE_URL")
    model = env.get("ANTHROPIC_MODEL")
    if base == DEEPSEEK_ANTHROPIC_BASE_URL:
        if model and model.startswith("claude-opus"):
            return "deepseek-pro", "DeepSeek V4 Pro", True, ""
        if model and (
            model.startswith("claude-sonnet") or model.startswith("claude-haiku")
        ):
            return "deepseek-flash", "DeepSeek V4 Flash", True, ""
        return (
            "inconsistent",
            "配置不一致",
            False,
            f"base_url 指向 DeepSeek 但模型未知：{model or '(空)'}",
        )
    # No DeepSeek base URL: this is the official Anthropic configuration.
    # The user's own model preferences (e.g. ANTHROPIC_MODEL) are their
    # business and are preserved/restored as-is.
    return "default", "Claude 官方", True, ""


# ---------------------------------------------------------------------------
# Detection: Claude Desktop / bundled Claude Code / standalone CLI


def _plist_version(plist_path: Path, key: str = "CFBundleShortVersionString") -> str:
    try:
        result = subprocess.run(
            ["/usr/libexec/PlistBuddy", "-c", f"Print :{key}", str(plist_path)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if result.returncode != 0:
        return ""
    return (result.stdout or "").strip()


def detect_claude_desktop() -> tuple[bool, str, str]:
    """Return (installed, version, app path).  Never raises."""
    candidates = [
        Path("/Applications/Claude.app"),
        Path.home() / "Applications" / "Claude.app",
    ]
    for candidate in candidates:
        info = candidate / "Contents" / "Info.plist"
        if not candidate.is_dir() or not info.is_file():
            continue
        version = _plist_version(info)
        if version:
            return True, version, str(candidate)
    return False, "", ""


def detect_bundled_claude_code() -> tuple[bool, str, str]:
    """Detect the Claude Code engine bundled inside the Claude Desktop app.

    Return (installed, version, binary path).
    """
    support = Path.home() / "Library" / "Application Support" / "Claude"
    code_root = support / "claude-code"
    if not code_root.is_dir():
        return False, "", ""
    versions = sorted(
        (entry for entry in code_root.iterdir() if entry.is_dir()),
        key=lambda entry: tuple(
            int(part) if part.isdigit() else part for part in entry.name.split(".")
        ),
        reverse=True,
    )
    for version_dir in versions:
        binary = version_dir / "claude.app" / "Contents" / "MacOS" / "claude"
        if binary.is_file() and os.access(binary, os.X_OK):
            version = _plist_version(
                version_dir / "claude.app" / "Contents" / "Info.plist"
            ) or version_dir.name
            return True, version, str(binary)
    return False, "", ""


def _try_version(binary: str) -> str:
    try:
        result = subprocess.run(
            [binary, "--version"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if result.returncode != 0:
        return ""
    output = (result.stdout or "").strip()
    return output.splitlines()[0][:200] if output else ""


def _is_managed_wrapper(binary: str) -> bool:
    try:
        with open(binary, "r", encoding="utf-8", errors="replace") as handle:
            head = handle.read(256)
    except OSError:
        return False
    return "claude-provider: managed launch wrapper" in head


def detect_claude_cli(claude_home: Path) -> tuple[bool, str, str]:
    """Detect a standalone ``claude`` CLI (optional compatibility target).

    Our own launch wrapper is never reported as the real CLI.
    """
    candidates: list[str] = []
    found = shutil.which("claude")
    if found:
        candidates.append(found)
    candidates.extend(
        [
            str(claude_home / "local" / "claude"),
            str(Path.home() / ".local" / "bin" / "claude"),
            str(Path.home() / ".npm-global" / "bin" / "claude"),
            "/usr/local/bin/claude",
            "/opt/homebrew/bin/claude",
        ]
    )
    seen: set[str] = set()
    for candidate in candidates:
        resolved = str(Path(candidate).expanduser())
        if resolved in seen or not os.path.isfile(resolved):
            continue
        seen.add(resolved)
        if _is_managed_wrapper(resolved):
            continue
        if not os.access(resolved, os.X_OK):
            continue
        version = _try_version(resolved)
        return True, version, resolved
    return False, "", ""


# ---------------------------------------------------------------------------
# Keychain


def keychain_ready(service: str = KEYCHAIN_SERVICE) -> bool:
    try:
        result = subprocess.run(
            ["/usr/bin/security", "find-generic-password", "-s", service],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        return False
    return result.returncode == 0


# ---------------------------------------------------------------------------
# Locking


@contextmanager
def provider_lock(claude_home: Path):
    path = lock_path(claude_home)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    handle = path.open("a+")
    try:
        try:
            import fcntl

            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ClaudeProviderError("另一个 Claude Code 配置切换正在进行中")
        except ImportError:
            pass
        yield
    finally:
        try:
            import fcntl

            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        except ImportError:
            pass
        handle.close()


# ---------------------------------------------------------------------------
# Official-state capture / restore


def save_official_state(claude_home: Path, settings: dict[str, Any]) -> None:
    """Snapshot the user's non-DeepSeek managed fields so ``default`` can
    restore them exactly."""
    env = env_of(settings)
    state: dict[str, Any] = {
        "env": {key: env.get(key) for key in MANAGED_ENV_KEYS},
        "apiKeyHelper": helper_of(settings),
    }
    atomic_write_json(official_state_path(claude_home), state)


def load_official_state(claude_home: Path) -> dict[str, Any]:
    path = official_state_path(claude_home)
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as handle:
        data = json.load(handle)
    return data if isinstance(data, dict) else {}


def restore_official_settings(
    settings: dict[str, Any], official: dict[str, Any]
) -> dict[str, Any]:
    updated = dict(settings)
    official_env = official.get("env")
    env = env_of(updated)
    if isinstance(official_env, dict):
        for key in MANAGED_ENV_KEYS:
            value = official_env.get(key)
            if value is None:
                env.pop(key, None)
            else:
                env[key] = str(value)
    else:
        for key in MANAGED_ENV_KEYS:
            env.pop(key, None)
    if env:
        updated["env"] = env
    else:
        updated.pop("env", None)
    if "apiKeyHelper" in official:
        if official["apiKeyHelper"] is None:
            updated.pop("apiKeyHelper", None)
        else:
            updated["apiKeyHelper"] = str(official["apiKeyHelper"])
    else:
        updated.pop("apiKeyHelper", None)
    return updated


def apply_deepseek_settings(
    settings: dict[str, Any],
    mode: str,
    proxy_env: dict[str, str] | None = None,
) -> dict[str, Any]:
    model = model_for_mode(mode)
    if model is None:
        raise ClaudeProviderError(f"未知模式：{mode}")
    if proxy_env is None:
        proxy_env = read_system_proxy_env()
    updated = dict(settings)
    env = env_of(updated)
    env.update(deepseek_env(model))
    # Write the dynamically detected system proxy; when no system proxy
    # exists we generate nothing and keep any pre-existing user values.
    for key, value in proxy_env.items():
        if value:
            env[key] = value
    updated["env"] = env
    updated["apiKeyHelper"] = API_KEY_HELPER_COMMAND
    return updated


# ---------------------------------------------------------------------------
# Claude Desktop Developer Mode / Custom 3p provider configuration


def deepseek_developer_settings(
    mode: str, helper_command: str
) -> dict[str, Any]:
    """Build the developer_settings.json ``inference`` + ``models`` blocks.

    Model entries use Anthropic canonical model ids; DeepSeek maps them
    server-side (claude-opus* -> V4 Pro, claude-sonnet*/haiku* -> V4 Flash).
    The ``anthropicFamilyTier`` pins the Desktop's opus/sonnet/haiku aliases,
    and the requested mode's model is placed first so it is the default.
    """
    entries = [
        {
            "name": PRO_MODEL,
            "labelOverride": "DeepSeek V4 Pro",
            "anthropicFamilyTier": "opus",
            "isFamilyDefault": True,
        },
        {
            "name": FLASH_MODEL,
            "labelOverride": "DeepSeek V4 Flash",
            "anthropicFamilyTier": "sonnet",
            "isFamilyDefault": True,
        },
        {
            "name": HAIKU_MODEL,
            "labelOverride": "DeepSeek V4 Flash · Haiku",
            "anthropicFamilyTier": "haiku",
            "isFamilyDefault": True,
        },
    ]
    if mode == "deepseek-flash":
        entries = [entries[1], entries[0], entries[2]]
    return {
        "inference": {
            "provider": "gateway",
            "baseUrl": DEEPSEEK_ANTHROPIC_BASE_URL,
            "credential": {
                "kind": "helper-script",
                "command": helper_command,
                "authScheme": "bearer",
            },
        },
        "models": {
            "discoveryEnabled": False,
            "list": entries,
        },
    }


def classify_developer_settings(
    developer: dict[str, Any],
) -> tuple[str, str, str, str]:
    """Classify a developer_settings.json object.

    Return (provider_state, default_tier, default_model, reason) where
    provider_state is "deepseek" / "official" / "unknown".
    """
    if not isinstance(developer, dict):
        return "unknown", "", "", "developer_settings.json 顶层必须是 JSON 对象"
    inference = developer.get("inference")
    if not isinstance(inference, dict):
        return "official", "", "", ""
    provider = inference.get("provider")
    base = inference.get("baseUrl") or ""
    if provider == "gateway" and base == DEEPSEEK_ANTHROPIC_BASE_URL:
        models = developer.get("models")
        default_model = ""
        default_tier = ""
        if isinstance(models, dict):
            entries = models.get("list")
            if isinstance(entries, list) and entries:
                first = entries[0]
                if isinstance(first, dict):
                    default_model = str(first.get("name") or "")
                    default_tier = str(first.get("anthropicFamilyTier") or "")
                else:
                    default_model = str(first)
                    if default_model.startswith("claude-opus"):
                        default_tier = "opus"
                    elif default_model.startswith("claude-sonnet"):
                        default_tier = "sonnet"
                    elif default_model.startswith("claude-haiku"):
                        default_tier = "haiku"
        if default_tier == "opus":
            return "deepseek", "opus", default_model, ""
        if default_tier in ("sonnet", "haiku"):
            return "deepseek", "flash", default_model, ""
        return (
            "deepseek",
            "unknown",
            default_model,
            "Desktop 模型列表缺少 opus/sonnet/haiku 家族标注",
        )
    if provider in ("anthropic", "bedrock", "vertex", "foundry", "mantle"):
        return "official", "", "", ""
    return "unknown", "", "", f"未知的 inference.provider：{provider}"


def combined_classify(
    settings_env: dict[str, str],
    developer: dict[str, Any],
) -> tuple[str, str, bool, str]:
    """Classify the two config layers together.

    ``~/.claude/settings.json`` is the single source of truth for the Claude
    Code DeepSeek state: a working engine must not be reported as
    "inconsistent" merely because the optional Desktop developer config does
    not carry DeepSeek ``inference``/``models`` blocks (it can contain only
    ``{"allowDevTools": true}`` or user-managed content and still work).
    The developer config is surfaced separately in the status output as
    optional Desktop-layer information.
    """
    env_state, env_label, env_consistent, env_reason = classify_env(settings_env)
    if env_state == "inconsistent":
        return env_state, env_label, False, env_reason
    if env_state == "default":
        return "default", "Claude 官方", True, ""
    return env_state, env_label, True, ""


def save_official_developer_state(
    claude_home: Path, dev_path: Path
) -> None:
    snapshot_path = official_developer_state_path(claude_home)
    if dev_path.exists():
        atomic_write_bytes(snapshot_path, dev_path.read_bytes())
    else:
        atomic_write_json(snapshot_path, {"__absent__": True})


def restore_official_developer_state(
    claude_home: Path, dev_path: Path
) -> None:
    snapshot_path = official_developer_state_path(claude_home)
    if not snapshot_path.exists():
        return
    try:
        parsed = json.loads(snapshot_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        parsed = None
    if isinstance(parsed, dict) and parsed.get("__absent__") is True:
        if dev_path.exists():
            dev_path.unlink()
        return
    atomic_write_bytes(dev_path, snapshot_path.read_bytes())


# ---------------------------------------------------------------------------
# Backups / switch / status


def make_backup(claude_home: Path, settings_path_: Path, mode: str) -> str | None:
    if not settings_path_.exists():
        return None
    directory = backup_dir(claude_home)
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    stamp = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}"
    target = directory / f"settings.json.{stamp}.before-{mode}.bak"
    shutil.copy2(settings_path_, target)
    os.chmod(target, 0o600)
    return str(target)


def make_file_backup(
    claude_home: Path, path: Path, mode: str, tag: str
) -> str | None:
    if not path.exists():
        return None
    directory = backup_dir(claude_home)
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    stamp = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}"
    target = directory / f"{tag}.{stamp}.before-{mode}.bak"
    shutil.copy2(path, target)
    os.chmod(target, 0o600)
    return str(target)


def switch_mode(
    mode: str,
    claude_home: Path,
    *,
    require_keychain: bool = True,
    claude_app_support: Path | None = None,
    helper_command: str | None = None,
    proxy_env: dict[str, str] | None = None,
) -> dict[str, str]:
    if mode not in MODE_LABELS:
        raise ClaudeProviderError(f"未知模式：{mode}")
    app_support = (
        claude_app_support
        if claude_app_support is not None
        else resolve_claude_app_support()
    )
    dev_path = developer_settings_path(app_support)
    helper = helper_command if helper_command is not None else credential_helper_command()

    with provider_lock(claude_home):
        path = settings_path(claude_home)
        original = read_settings(path)
        original_env = env_of(original)
        dev_existed_before = dev_path.exists()
        try:
            original_dev = read_settings(dev_path)
        except ClaudeProviderError:
            original_dev = {}
        original_dev_state, _, _, _ = classify_developer_settings(original_dev)

        if mode != "default" and require_keychain and not keychain_ready():
            raise ClaudeProviderError(
                "缺少 Keychain 凭据：claude-code-deepseek-api-key。"
                "请先运行：security add-generic-password -s "
                "claude-code-deepseek-api-key -a deepseek -w sk-你的-key"
            )

        # Preserve the user's original official state before the first
        # DeepSeek switch so "default" can fully restore it later.
        if mode != "default":
            current_state, _, _, _ = classify_env(original_env)
            if current_state == "default":
                save_official_state(claude_home, original)
            if original_dev_state != "deepseek":
                save_official_developer_state(claude_home, dev_path)

        if mode == "default":
            official = load_official_state(claude_home)
            if not official:
                # No prior DeepSeek switch: nothing to restore, keep current.
                new_settings = original
            else:
                new_settings = restore_official_settings(original, official)
        else:
            new_settings = apply_deepseek_settings(original, mode, proxy_env)

        if mode == "default":
            # Restore the original developer_settings.json (or delete the
            # one we created) when the Desktop currently points at DeepSeek.
            if original_dev_state != "official":
                new_dev: dict[str, Any] | None = {"__restore__": True}
            else:
                new_dev = None
        else:
            managed = deepseek_developer_settings(mode, helper)
            candidate_dev = dict(original_dev)
            candidate_dev["inference"] = managed["inference"]
            candidate_dev["models"] = managed["models"]
            if candidate_dev == original_dev:
                new_dev = None
            else:
                new_dev = candidate_dev

        if new_settings == original and new_dev is None:
            result: dict[str, str] = {
                "state": mode,
                "state_label": MODE_LABELS[mode],
                "backup": "",
            }
            if mode != "default":
                for key, out_key in (
                    ("HTTP_PROXY", "proxy_http"),
                    ("HTTPS_PROXY", "proxy_https"),
                ):
                    value = original_env.get(key, "")
                    if value:
                        result[out_key] = value
            return result

        backup = ""
        dev_backup = ""
        try:
            if new_settings != original:
                backup = make_backup(claude_home, path, mode) or ""
                atomic_write_json(path, new_settings)

            if new_dev is not None:
                dev_backup = (
                    make_file_backup(claude_home, dev_path, mode, "developer_settings.json")
                    or ""
                )
                if isinstance(new_dev, dict) and new_dev.get("__restore__") is True:
                    restore_official_developer_state(claude_home, dev_path)
                else:
                    atomic_write_json(dev_path, new_dev)

            # Final verification: reload and confirm the result matches.
            reloaded = read_settings(path)
            if new_settings != original and reloaded != new_settings:
                raise ClaudeProviderError("写入后校验失败：settings.json 状态与预期不符")
            if new_dev is not None:
                if isinstance(new_dev, dict) and new_dev.get("__restore__") is True:
                    # Verify the restored bytes match the official snapshot.
                    snapshot_path = official_developer_state_path(claude_home)
                    if snapshot_path.exists():
                        expected_bytes = snapshot_path.read_bytes()
                        try:
                            snapshot_parsed = json.loads(
                                snapshot_path.read_text(encoding="utf-8")
                            )
                        except (OSError, json.JSONDecodeError):
                            snapshot_parsed = None
                        if (
                            isinstance(snapshot_parsed, dict)
                            and snapshot_parsed.get("__absent__") is True
                        ):
                            matches = not dev_path.exists()
                        else:
                            matches = (
                                dev_path.exists()
                                and dev_path.read_bytes() == expected_bytes
                            )
                        if not matches:
                            raise ClaudeProviderError(
                                "写入后校验失败：developer_settings.json 恢复结果与快照不符"
                            )
                else:
                    reloaded_dev = (
                        read_settings(dev_path) if dev_path.exists() else {}
                    )
                    if reloaded_dev != new_dev:
                        raise ClaudeProviderError(
                            "写入后校验失败：developer_settings.json 状态与预期不符"
                        )
        except Exception:
            if backup and Path(backup).exists() and new_settings != original:
                shutil.copy2(backup, path)
            if new_dev is not None:
                if dev_backup and Path(dev_backup).exists():
                    shutil.copy2(dev_backup, dev_path)
                elif dev_path.exists() and not dev_existed_before:
                    dev_path.unlink()
            raise

    result: dict[str, str] = {
        "state": mode,
        "state_label": MODE_LABELS[mode],
        "backup": backup or "",
    }
    if mode != "default":
        final_env = env_of(new_settings)
        for key, out_key in (("HTTP_PROXY", "proxy_http"), ("HTTPS_PROXY", "proxy_https")):
            value = final_env.get(key, "")
            if value:
                result[out_key] = value
    return result


def status(
    claude_home: Path,
    *,
    claude_app_support: Path | None = None,
    environment: dict[str, str] | None = None,
) -> str:
    path = settings_path(claude_home)
    app_support = (
        claude_app_support
        if claude_app_support is not None
        else resolve_claude_app_support(environment)
    )
    dev_path = developer_settings_path(app_support)
    developer: dict[str, Any] = {}
    try:
        settings = read_settings(path)
        env = env_of(settings)
        helper = helper_of(settings)
    except ClaudeProviderError as exc:
        env, helper = {}, None
        settings_reason = str(exc)
    else:
        settings_reason = ""
    try:
        developer = read_settings(dev_path)
    except ClaudeProviderError as exc:
        developer = {}
        developer_reason = str(exc)
    else:
        developer_reason = ""

    dev_state, dev_tier, dev_default_model, dev_classify_reason = (
        classify_developer_settings(developer)
    )
    if settings_reason:
        state, label, consistent, reason = (
            "inconsistent",
            "配置不一致",
            False,
            settings_reason,
        )
    else:
        # settings.json is the single source of truth for the Claude Code
        # state; the developer config is optional Desktop-layer info only.
        state, label, consistent, reason = combined_classify(env, developer)

    desktop_installed, desktop_version, desktop_path = detect_claude_desktop()
    engine_installed, engine_version, engine_path = detect_bundled_claude_code()
    cli_installed, cli_version, cli_path = detect_claude_cli(claude_home)
    auth = keychain_ready()
    lines: list[str] = []
    lines.append(f"current_state={state}")
    lines.append(f"state_label={label}")
    lines.append(f"state_consistent={'yes' if consistent else 'no'}")
    lines.append(f"inconsistency_reason={reason}")
    lines.append(f"desktop_installed={'yes' if desktop_installed else 'no'}")
    lines.append(f"desktop_version={desktop_version}")
    lines.append(f"desktop_path={desktop_path}")
    lines.append(f"claude_code_installed={'yes' if engine_installed else 'no'}")
    lines.append(f"claude_code_version={engine_version}")
    lines.append(f"claude_code_path={engine_path}")
    lines.append(f"cli_installed={'yes' if cli_installed else 'no'}")
    lines.append(f"cli_version={cli_version}")
    lines.append(f"cli_path={cli_path}")
    lines.append(f"settings_path={path}")
    lines.append(f"developer_settings_path={dev_path}")
    lines.append(f"desktop_provider={'gateway' if dev_state == 'deepseek' else ('anthropic' if dev_state == 'official' else 'unknown')}")
    lines.append(f"desktop_default_model={dev_default_model}")
    lines.append(f"developer_settings_note={developer_reason or dev_classify_reason}")
    lines.append(f"base_url={env.get('ANTHROPIC_BASE_URL', '')}")
    lines.append(f"model={env.get('ANTHROPIC_MODEL', '')}")
    lines.append(f"env_http_proxy={env.get('HTTP_PROXY', '')}")
    lines.append(f"env_https_proxy={env.get('HTTPS_PROXY', '')}")
    system_proxy = read_system_proxy_env()
    lines.append(f"system_http_proxy={system_proxy.get('HTTP_PROXY', '')}")
    lines.append(f"system_https_proxy={system_proxy.get('HTTPS_PROXY', '')}")
    lines.append(f"api_key_helper={'present' if helper else 'absent'}")
    lines.append(f"auth={'keychain-helper' if auth else 'MISSING'}")
    lines.append(f"keychain_service={KEYCHAIN_SERVICE}")
    lines.append(f"backup_dir={backup_dir(claude_home)}")
    return "\n".join(lines) + "\n"


def main(argv: list[str]) -> int:
    import argparse

    parser = argparse.ArgumentParser(prog="claude-provider")
    parser.add_argument(
        "command",
        choices=["status", "default", "deepseek-pro", "deepseek-flash"],
    )
    args = parser.parse_args(argv)
    claude_home = resolve_claude_home()
    if args.command == "status":
        sys_stdout_write(status(claude_home))
        return 0
    try:
        result = switch_mode(args.command, claude_home)
    except ClaudeProviderError as exc:
        sys_stderr_write(f"claude-provider: {exc}\n")
        return 1
    sys_stdout_write(f"current_state={result['state']}\n")
    sys_stdout_write(f"state_label={result['state_label']}\n")
    if result["backup"]:
        sys_stdout_write(f"backup={result['backup']}\n")
    if result.get("proxy_http"):
        sys_stdout_write(f"proxy_http={result['proxy_http']}\n")
    if result.get("proxy_https"):
        sys_stdout_write(f"proxy_https={result['proxy_https']}\n")
    sys_stdout_write(
        "配置切换完成。独立 claude CLI 的新会话立即生效；"
        "Claude Desktop 需重启后生效（GUI 会自动重启）。\n"
    )
    return 0


def sys_stdout_write(text: str) -> None:
    import sys

    sys.stdout.write(text)


def sys_stderr_write(text: str) -> None:
    import sys

    sys.stderr.write(text)


if __name__ == "__main__":
    import sys as _sys

    raise SystemExit(main(_sys.argv[1:]))
