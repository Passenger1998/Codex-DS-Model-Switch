# ---------------------------------------------------------------------------
# Durable JSON/file handling


def _json_bytes(data: Any) -> bytes:
    return json.dumps(data, ensure_ascii=False, indent=2).encode() + b"\n"


def _fsync_directory(directory: Path) -> None:
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
    descriptor = os.open(str(directory), flags)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_write_bytes(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=str(path.parent)
    )
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary_name, 0o600)
        os.replace(temporary_name, path)
        _fsync_directory(path.parent)
    except BaseException:
        if os.path.exists(temporary_name):
            os.unlink(temporary_name)
        raise


def atomic_write_json(path: Path, data: Any) -> None:
    atomic_write_bytes(path, _json_bytes(data))


def atomic_remove(path: Path) -> None:
    if not path.exists():
        return
    tombstone = path.parent / f".{path.name}.deleted-{os.getpid()}-{time.time_ns()}"
    os.replace(path, tombstone)
    _fsync_directory(path.parent)
    try:
        tombstone.unlink()
        _fsync_directory(path.parent)
    except BaseException:
        if tombstone.exists() and not path.exists():
            os.replace(tombstone, path)
            _fsync_directory(path.parent)
        raise


def read_json_object(path: Path, label: str) -> dict[str, Any]:
    if not path.exists():
        return {}
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except json.JSONDecodeError as exc:
        raise ClaudeProviderError(f"{label} 不是合法 JSON：{exc}") from exc
    except OSError as exc:
        raise ClaudeProviderError(f"无法读取 {label}：{exc}") from exc
    if not isinstance(data, dict):
        raise ClaudeProviderError(f"{label} 顶层必须是 JSON 对象")
    return data


def read_settings(path: Path) -> dict[str, Any]:
    return read_json_object(path, "settings.json")


def env_of(settings: dict[str, Any]) -> dict[str, str]:
    raw = settings.get("env")
    if raw is None:
        return {}
    if not isinstance(raw, dict):
        raise ClaudeProviderError('settings.json 的 "env" 字段必须是对象')
    return {str(key): str(value) for key, value in raw.items()}


def helper_of(settings: dict[str, Any]) -> str | None:
    raw = settings.get("apiKeyHelper")
    return None if raw is None else str(raw)


# ---------------------------------------------------------------------------
# macOS system proxy


def parse_scutil_proxy_output(text: str) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in text.splitlines():
        match = re.match(r"^\s*([A-Za-z]+)\s*:\s*(.*?)\s*$", line)
        if match:
            values[match.group(1)] = match.group(2)

    def endpoint(prefix: str) -> str | None:
        if values.get(f"{prefix}Enable") != "1":
            return None
        host = values.get(f"{prefix}Proxy", "").strip()
        try:
            port = int(values.get(f"{prefix}Port", "0"))
        except ValueError:
            return None
        if not host or not 1 <= port <= 65535:
            return None
        formatted = f"[{host}]" if ":" in host and not host.startswith("[") else host
        return f"http://{formatted}:{port}"

    http_endpoint = endpoint("HTTP")
    https_endpoint = endpoint("HTTPS")
    result: dict[str, str] = {}
    if http_endpoint or https_endpoint:
        result["HTTP_PROXY"] = http_endpoint or https_endpoint or ""
        result["HTTPS_PROXY"] = https_endpoint or http_endpoint or ""
    return result


def read_system_proxy_env() -> dict[str, str]:
    if sys.platform != "darwin" or not os.path.isfile("/usr/sbin/scutil"):
        return {}
    try:
        result = subprocess.run(
            ["/usr/sbin/scutil", "--proxy"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return {}
    return parse_scutil_proxy_output(result.stdout) if result.returncode == 0 else {}


