# Direct Claude Code CLI config


def deepseek_env(model: str) -> dict[str, str]:
    return {
        "ANTHROPIC_BASE_URL": DEEPSEEK_ANTHROPIC_BASE_URL,
        "ANTHROPIC_MODEL": model,
        "ANTHROPIC_DEFAULT_OPUS_MODEL": PRO_MODEL,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": FLASH_MODEL,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": FLASH_MODEL,
        "ANTHROPIC_SMALL_FAST_MODEL": FLASH_MODEL,
        "CLAUDE_CODE_SUBAGENT_MODEL": model,
    }


def model_for_mode(mode: str) -> str | None:
    return {"deepseek-pro": PRO_MODEL, "deepseek-flash": FLASH_MODEL}.get(mode)


def classify_env(env: dict[str, str]) -> tuple[str, str, bool, str]:
    if env.get("ANTHROPIC_BASE_URL") != DEEPSEEK_ANTHROPIC_BASE_URL:
        return "default", MODE_LABELS["default"], True, ""
    model = env.get("ANTHROPIC_MODEL")
    if model == PRO_MODEL:
        return "deepseek-pro", MODE_LABELS["deepseek-pro"], True, ""
    if model == FLASH_MODEL:
        return "deepseek-flash", MODE_LABELS["deepseek-flash"], True, ""
    return (
        "inconsistent",
        "配置不一致",
        False,
        f"直接 CLI 指向 DeepSeek，但默认模型不是 {PRO_MODEL}/{FLASH_MODEL}",
    )


def apply_deepseek_settings(
    settings: dict[str, Any],
    mode: str,
    helper_command: str,
    proxy_env: dict[str, str] | None = None,
) -> dict[str, Any]:
    model = model_for_mode(mode)
    if model is None:
        raise ClaudeProviderError(f"未知模式：{mode}")
    proxy_env = read_system_proxy_env() if proxy_env is None else proxy_env
    updated = dict(settings)
    env = env_of(updated)
    env.update(deepseek_env(model))
    for key in ("HTTP_PROXY", "HTTPS_PROXY"):
        if proxy_env.get(key):
            env[key] = proxy_env[key]
    updated["env"] = env
    updated["apiKeyHelper"] = helper_command
    return updated


def restore_official_settings(
    settings: dict[str, Any], baseline: dict[str, Any]
) -> dict[str, Any]:
    updated = dict(settings)
    env = env_of(updated)
    baseline_env = env_of(baseline)
    for key in MANAGED_ENV_KEYS:
        if key in baseline_env:
            env[key] = baseline_env[key]
        else:
            env.pop(key, None)
    if env:
        updated["env"] = env
    else:
        updated.pop("env", None)
    if "apiKeyHelper" in baseline:
        updated["apiKeyHelper"] = baseline["apiKeyHelper"]
    else:
        updated.pop("apiKeyHelper", None)
    return updated


